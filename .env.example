# flyer TS 版配置示例
LLM_API_KEY=            # 或 DEEPSEEK_API_KEY
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
AGENT_DRY_RUN=false

# 鉴权
AUTH_MODE=none          # none / api_key / jwt
# JWT_PUBLIC_KEY=       # base64 单行（flyer-biz gen_keys.py 生成）
JWT_ALGORITHM=RS256

# 语义缓存
EMBEDDING_PROVIDER=     # ollama / cloud
VECTOR_STORE=memory
CACHE_THRESHOLD=0.9

# 业务库对接（flyer-biz）
BIZ_BASE_URL=http://127.0.0.1:9000
BIZ_API_KEY=dev-biz-key
