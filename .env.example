# flyer TS 版配置示例（全部可配置项；缺省值见 src/core/config.ts）
LLM_API_KEY=            # 或 DEEPSEEK_API_KEY（两者取其一）
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
AGENT_DRY_RUN=false     # true = 不调 LLM（测试/降级）
CONTEXT_WINDOW_ROUNDS=3 # 意图识别喂入的对话历史轮数

# 鉴权
AUTH_MODE=none          # none / api_key / jwt
API_KEYS=               # AUTH_MODE=api_key 时必填，逗号分隔多个 key
# JWT_PUBLIC_KEY=       # AUTH_MODE=jwt 时必填，base64 单行（业务系统签发）
JWT_ALGORITHM=RS256

# 语义缓存（EMBEDDING_PROVIDER 为空 = 缓存禁用）
EMBEDDING_PROVIDER=     # none（空）/ ollama / cloud
EMBEDDING_MODEL=bge-m3:567m
EMBEDDING_OLLAMA_URL=http://localhost:11434
EMBEDDING_CLOUD_API_KEY=    # cloud 模式必填
EMBEDDING_CLOUD_BASE_URL=   # cloud 模式；缺省 openai 兼容 /embeddings
RECALL_THRESHOLD=0.75   # 意图预筛 embedding 召回阈值（关键词零命中的语义兜底；
                        # 通用 embedding 区分度有限，阈值保守防误召回）
CACHE_THRESHOLD=0.9     # 语义缓存命中相似度阈值
CACHE_BUSTING=1         # 缓存失效版本号（升级模型/策略后 +1）
VECTOR_STORE=memory     # memory / sqlite
VECTOR_DB_PATH=data/cache.db

# 用量与记忆存储
USAGE_STORE=memory      # memory / sqlite
USAGE_DB_PATH=data/usage.db
CHECKPOINTER=memory     # memory / sqlite（会话续接）
CHECKPOINT_DB_PATH=data/agent_checkpoints.db

# 业务系统对接（技能通过业务 API 执行；契约见 docs/）
BIZ_BASE_URL=http://127.0.0.1:9000
BIZ_API_KEY=dev-biz-key
