# flyer TS 版配置示例
LLM_API_KEY=            # 或 DEEPSEEK_API_KEY
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
AGENT_DRY_RUN=false

# 鉴权
AUTH_MODE=none          # none / api_key / jwt
# JWT_PUBLIC_KEY=       # base64 单行（业务系统签发）
JWT_ALGORITHM=RS256

# 语义缓存
EMBEDDING_PROVIDER=     # ollama / cloud
RECALL_THRESHOLD=0.75   # 意图预筛 embedding 召回阈值（关键词零命中的语义兜底；
                        # 通用 embedding 区分度有限，阈值保守防误召回）
VECTOR_STORE=memory
CACHE_THRESHOLD=0.9

# 业务系统对接（商城后端；技能通过业务 API 执行）
BIZ_BASE_URL=http://127.0.0.1:9000
BIZ_API_KEY=dev-biz-key
