{
  "name": "flyer",
  "version": "0.1.0",
  "description": "商城智能交互网关：商城界面与业务系统之间的 Agent 编排层（model + harness）",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "api": "tsx src/api/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "check": "npm run typecheck && npm test",
    "health": "tsx scripts/health-audit.ts",
    "health:ci": "CI=true tsx scripts/health-audit.ts",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=20"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.12",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "@langchain/openai": "^1.5.10",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.1",
    "jose": "^6.2.10",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
